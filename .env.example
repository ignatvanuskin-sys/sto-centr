# ─────────────────────────── Домен сайта ───────────────────────────
# Нужен для абсолютных ссылок в Open Graph, robots.txt и sitemap.xml.
# Без него подставляется http://localhost:3210.
NEXT_PUBLIC_SITE_URL=https://example.kz

# ───────────────────────── Панель заявок /admin ─────────────────────────
# Пароль администратора. ОБЯЗАТЕЛЬНО задайте свой:
# без ADMIN_PASSWORD в продакшене вход в панель полностью закрыт (fail closed) —
# это защищает заявки клиентов, если адрес панели кто-то угадает.
ADMIN_PASSWORD=замените-на-сложный-пароль

# Ключ подписи сессии (любая случайная строка). Если не задан — выводится из пароля.
ADMIN_SECRET=

# ─────────────────────── Где хранить заявки ───────────────────────
# Локально и на VPS/Docker ничего настраивать не нужно: заявки пишутся
# в файл data/bookings.json.
# На Vercel/Netlify файловая система только для чтения — подключите
# Upstash Redis или Vercel KV (любой из двух наборов переменных):
KV_REST_API_URL=
KV_REST_API_TOKEN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────── Дублирование заявок в Telegram (рекомендуется) ───────────────
# Заявка приходит в чат сервиса сразу, даже если панель никто не открыл.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
